{
  "name": "media-audio-lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestore di libreria audio con editing dei metadati, viste multiple e player integrato.",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:app": "tauri build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "coverage:rust": "node -e \"require('fs').mkdirSync('src-tauri/coverage',{recursive:true})\" && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"(main|lib)\\.rs$\" --fail-under-functions 80 --lcov --output-path src-tauri/coverage/lcov.info",
    "coverage:rust:summary": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"(main|lib)\\.rs$\" --summary-only",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "verify:rust": "npm run format:rust:check && npm run lint:rust && npm run coverage:rust",
    "verify:all": "npm run verify && npm run verify:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
